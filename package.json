{
  "name": "velnu",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-deployment.mjs && tsc -b && vite build",
    "test:deployment": "node --test tests/deployment/*.test.mjs",
    "preview": "vite preview",
    "test:unit": "deno test tests/unit/",
    "test:stress": "deno test --unstable-sloppy-imports tests/stress/velnu-1500-inputs_test.ts",
    "test:recovery": "tsc supabase/functions/_shared/providerRequest.ts supabase/functions/_shared/signedEvents.ts supabase/functions/_shared/healthStatus.ts --target ES2022 --module ES2022 --lib ES2022,DOM --strict --skipLibCheck --outDir .recovery-build && node --test tests/recovery/*.test.mjs",
    "test:e2e": "playwright test",
    "test:services": "node --test tests/financial/*.test.mjs",
    "test:campaign": "node scripts/qa/stress-engine.mjs",
    "typecheck:calendar": "tsc -p tsconfig.calendar.json",
    "test:calendar": "node --import tsx --test tests/calendar/*.test.ts",
    "build:calendar": "tsc -p tsconfig.calendar-build.json",
    "start:calendar": "node .calendar-build/run.js",
    "test:records": "node --import tsx --test tests/records/*.test.ts",
    "test:settings": "node --import tsx --test tests/settings/*.test.ts",
    "test:scheduling": "node --import tsx --test tests/scheduling/*.test.ts"
  },
  "dependencies": {
    "@azure/msal-node": "7.1.2",
    "@microsoft/microsoft-graph-client": "3.0.7",
    "@supabase/supabase-js": "^2.57.4",
    "google-auth-library": "11.3.2",
    "googleapis": "189.0.0",
    "luxon": "3.7.2",
    "pg": "8.23.1",
    "posthog-js": "1.438.21",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.14",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/luxon": "3.7.6",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "supabase": "3.0.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  }
}
