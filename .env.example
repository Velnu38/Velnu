# Copy to .env.local and configure your staging project explicitly.
# Public browser configuration only; never put service-role or provider secrets here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_ENABLE_CUSTOMER_ACTIONS=false

# On Vercel, configure these build-only variables separately per target.
# Preview/Development: staging. Production: production.
FINVIANT_DEPLOYMENT_ENV=staging
FINVIANT_SUPABASE_PROJECT_REF=xvybcmyoblfgzokaifsx
# Production only: the exact reviewed release branch.
FINVIANT_PRODUCTION_GIT_REF=
