{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "types": ["node"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": [
    "server/calendar/**/*.ts",
    "api/calendar*.ts",
    "api/calendar/**/*.ts",
    "tests/calendar/**/*.ts"
  ]
}
